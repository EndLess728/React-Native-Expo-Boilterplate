# .easignore — files NOT to upload to EAS Build servers.
#
# EAS Build falls back to .gitignore by default, but .gitignore excludes the
# .env.<env> files (since they may contain secrets). EAS still needs them
# during the build because scripts/eas-pre-install.sh copies the matching one
# into .env.local before `yarn install`.
#
# This file is identical to .gitignore EXCEPT we explicitly un-ignore the
# environment files so EAS receives them.

# dependencies
node_modules/

# React Native
npm-debug.log*
yarn-debug.log*
yarn-error.log*
expo-debug.log
expo-error.log

# Native — generated by `expo prebuild`, never commit
android/
ios/

# macOS
.DS_Store

# JetBrains IDEs
.idea/
*.iml

# Logs
*.log

# OS-specific files
Thumbs.db
ehthumbs.db

# Expo
.expo/
dist/
web-build/
.expo-shared/

# Native signing & credentials
*.orig.*
*.jks
*.p8
*.p12
*.key
*.pem
*.keystore
*.mobileprovision
*.apk
*.ap_
*.dex
*.class
*.hprof

# Metro
.metro-health-check*

# typescript
*.tsbuildinfo

# Expo
expo-env.d.ts

# Local-only env files (regenerated by scripts/EAS hook)
.env*.local

# Test / dev tooling not needed for builds
__mocks__/
__tests__/
*.test.ts
*.test.tsx
.husky/
.vscode/
.cursor/
.claude/
.code-review-graph/
docs/
IMPROVEMENT_REPORT.md

# Keep .env.<env> for EAS — they are gitignored but EAS needs them. The
# `scripts/eas-pre-install.sh` hook copies one to .env.local before install.
!.env.development
!.env.staging
!.env.production
