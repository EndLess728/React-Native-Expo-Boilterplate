# Copy this file and rename to .env.development / .env.staging / .env.production
# Fill in the values for each environment. Never commit those files.
#
# Usage:
#   cp .env.example .env.development
#   cp .env.example .env.staging
#   cp .env.example .env.production

EXPO_PUBLIC_APP_ENV=development

EXPO_PUBLIC_API_URL=https://your-api.example.com/
EXPO_PUBLIC_SOCKET_URL=https://your-socket.example.com
