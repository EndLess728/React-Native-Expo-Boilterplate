#!/usr/bin/env sh
. "$(dirname "$0")/common.sh"

# Auto-install dependencies when `yarn.lock` was touched by the merge —
# saves the "did you forget to yarn install?" debugging round.
changed() {
  git diff --name-only HEAD@{1} HEAD | grep -q "^$1$"
}

if changed 'yarn.lock'; then
  echo "yarn.lock changed — running 'yarn install' to sync dependencies..."
  yarn install
fi

exit 0
