{
  "name": "@repo/mobile",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "start:development": "cp .env.development .env.local && expo start --dev-client",
    "start:staging": "cp .env.staging .env.local && expo start --dev-client",
    "start:production": "cp .env.production .env.local && expo start --dev-client",
    "android:development": "cp .env.development .env.local && expo run:android",
    "android:staging": "cp .env.staging .env.local && expo run:android",
    "android:production": "cp .env.production .env.local && expo run:android",
    "ios:development": "cp .env.development .env.local && expo run:ios",
    "ios:staging": "cp .env.staging .env.local && expo run:ios",
    "ios:production": "cp .env.production .env.local && expo run:ios",
    "prebuild:development": "cp .env.development .env.local && STRICT_ENV_VALIDATION=1 expo prebuild --clean",
    "prebuild:staging": "cp .env.staging .env.local && STRICT_ENV_VALIDATION=1 expo prebuild --clean",
    "prebuild:production": "cp .env.production .env.local && STRICT_ENV_VALIDATION=1 expo prebuild --clean",
    "build:android:development": "cp .env.development .env.local && STRICT_ENV_VALIDATION=1 sh -c 'expo prebuild --clean --platform android && cd android && ./gradlew assembleRelease'",
    "build:android:staging": "cp .env.staging .env.local && STRICT_ENV_VALIDATION=1 sh -c 'expo prebuild --clean --platform android && cd android && ./gradlew assembleRelease'",
    "build:android:production": "cp .env.production .env.local && STRICT_ENV_VALIDATION=1 sh -c 'expo prebuild --clean --platform android && cd android && ./gradlew assembleRelease'",
    "build:ios:development": "cp .env.development .env.local && STRICT_ENV_VALIDATION=1 sh -c 'expo prebuild --clean --platform ios && open ios/*.xcworkspace'",
    "build:ios:staging": "cp .env.staging .env.local && STRICT_ENV_VALIDATION=1 sh -c 'expo prebuild --clean --platform ios && open ios/*.xcworkspace'",
    "build:ios:production": "cp .env.production .env.local && STRICT_ENV_VALIDATION=1 sh -c 'expo prebuild --clean --platform ios && open ios/*.xcworkspace'",
    "eas-build-pre-install": "cp .env.${EXPO_PUBLIC_APP_ENV:-development} .env.local",
    "postinstall": "patch-package",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@repo/business-logic": "*",
    "@dev-plugins/react-query": "^0.4.0",
    "@expo/metro-runtime": "~6.1.2",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.4.6",
    "@react-navigation/drawer": "^7.5.7",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.25",
    "@tanstack/react-query": "^5.90.16",
    "@types/react": "~19.1.10",
    "axios": "^1.6.8",
    "babel-plugin-module-resolver": "^5.0.2",
    "expo": "^54.0.29",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.12",
    "expo-dev-client": "~6.0.20",
    "expo-font": "~14.0.10",
    "expo-localization": "~17.0.8",
    "expo-splash-screen": "~31.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "i18next": "^25.8.0",
    "patch-package": "^8.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.71.1",
    "react-i18next": "^16.5.3",
    "react-native": "0.81.5",
    "react-native-edge-to-edge": "1.6.0",
    "react-native-error-boundary": "^3.1.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-mmkv": "^4.1.0",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-nitro-modules": "^0.33.2",
    "react-native-reanimated": "~4.1.1",
    "react-native-restart": "^0.0.27",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-toast-message": "^2.3.0",
    "react-native-unistyles": "^3.0.20",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "react-query-kit": "^3.3.2",
    "typescript": "~5.9.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@commitlint/cli": "^20.3.0",
    "@commitlint/config-conventional": "^20.3.0",
    "@types/react-native": "^0.72.8",
    "@types/react-redux": "^7.1.34",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "eslint": "^9.39.2",
    "eslint-config-expo": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-babel-module": "^5.3.2",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-i18n-json": "^4.0.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-native-unistyles": "^3.0.7",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-testing-library": "^7.14.0",
    "eslint-plugin-unicorn": "^62.0.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.49.0"
  },
  "private": true
}
