{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@env": [
        "./env"
      ],
      "@repo/shared": [
        "../../packages/shared/src"
      ]
    },
    "esModuleInterop": true,
    "checkJs": true
  },
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "android",
    "ios",
    "plugins"
  ],
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
