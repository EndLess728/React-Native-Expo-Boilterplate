  "Screen": {
    "prefix": "rnfu",
    "body": [
      "import React from 'react';",
      "import { Text } from 'react-native';",
      "",
      "import ScreenWrapper from '@/shared/components/ScreenWrapper';",
      "",
      "export function ${1:ScreenName}Screen() {",
      "  return (",
      "    <ScreenWrapper className=\"items-center justify-center p-5\">",
      "      <Text className=\"text-h1 font-opensans-bold text-typography\">${1:ScreenName}</Text>",
      "    </ScreenWrapper>",
      "  );",
      "}",
      "",
    ],
    "description": "Screen component with ScreenWrapper and Tailwind classes",
  },
